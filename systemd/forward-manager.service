[Unit]
Description=Forward Manager - Core Failover Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/forward-manager
ExecStart=/usr/bin/python3 /opt/forward-manager/core/engine.py
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
