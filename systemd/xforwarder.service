[Unit]
Description=XForwarder - Core Failover Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xforwarder
ExecStart=/usr/bin/python3 /opt/xforwarder/core/engine.py
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
